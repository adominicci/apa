{
  "name": "@tesina/desktop",
  "version": "0.1.0",
  "description": "Tesina desktop app (Tauri 2 + Svelte 5)",
  "private": true,
  "type": "module",
  "scripts": {
    "vite:dev": "vite dev",
    "vite:build": "vite build",
    "vite:preview": "vite preview",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "app:check": "deno task paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "app:check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-http": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@fontsource-variable/inter": "^5.1.0",
    "@tesina/docx-export": "*",
    "@tesina/engine": "*",
    "@tiptap/core": "^3.6.5",
    "@tiptap/extension-table": "^3.6.5",
    "@tiptap/pm": "^3.6.5",
    "@tiptap/starter-kit": "^3.6.5",
    "pagedjs": "^0.4.3"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.4.0",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "@tauri-apps/cli": "^2"
  }
}
